# Ambiente do backend: development | test | production
NODE_ENV=development

# Porta HTTP do backend
PORT=3000

# Única origem de navegador autorizada pelo CORS
FRONTEND_ORIGIN=http://localhost:4200

# Gemini: descomente e preencha somente no .env local; nunca registre/versione a chave
# GEMINI_API_KEY=adicione-a-chave-somente-no-env-local

# Modelo Gemini autorizado para a chave local
GEMINI_MODEL=replace-with-supported-model

# Tempo máximo da chamada externa em milissegundos
GEMINI_TIMEOUT_MS=120000

# Limite máximo de upload em bytes (10 MiB)
MAX_FILE_SIZE_BYTES=10485760

# Janela e quantidade máxima de requisições por cliente
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10
